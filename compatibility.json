{
  "schema_version": 1,
  "sdk": {
    "version": "0.4.0",
    "python": [
      "3.11",
      "3.12"
    ],
    "status": "pre-1.0"
  },
  "certified_runtime": {
    "databricks_runtime": "18.0.x-scala2.13",
    "dependency_policy": "dependency-policy.toml",
    "lock": "uv.lock"
  },
  "templates": {
    "agent-app": {
      "version": "1.2.0",
      "aai_core": "0.4.0",
      "dependency_lock_format": "universal-transitive-v1"
    },
    "analytics-app": {
      "version": "1.0.0",
      "aai_core": "0.4.0",
      "dependency_lock_format": "universal-transitive-v1"
    },
    "evaluation-project": {
      "version": "2.0.0",
      "aai_core": "0.4.0",
      "dependency_lock_format": "universal-transitive-v1"
    },
    "experiment-starter": {
      "version": "1.1.0",
      "aai_core": "0.4.0",
      "dependency_lock_format": "universal-transitive-v1"
    },
    "prompt-app": {
      "version": "1.2.0",
      "aai_core": "0.4.0",
      "dependency_lock_format": "universal-transitive-v1"
    },
    "rag-app": {
      "version": "1.2.0",
      "aai_core": "0.4.0",
      "dependency_lock_format": "universal-transitive-v1"
    }
  },
  "features": {
    "experiment_tracking": {
      "support": "stable",
      "owner": "aai-core"
    },
    "mlflow_tracing": {
      "support": "stable",
      "owner": "aai-core"
    },
    "framework_autologging": {
      "support": "preview",
      "owner": "aai-core-opt-in"
    },
    "provider_native_async_streaming": {
      "support": "native-provider",
      "owner": "application",
      "note": "aai-core configures and returns native async clients; callers own their event-loop-local lifecycle and native stream types."
    },
    "prompt_registry": {
      "support": "preview",
      "owner": "mlflow-native-with-aai-governance"
    },
    "genai_evaluation": {
      "support": "preview",
      "owner": "mlflow-native-with-aai-gates"
    },
    "foundry_cloud_evaluation": {
      "support": "native-provider",
      "owner": "curriculum-opt-in",
      "note": "Response-ID and agent-target evaluation are current; trace and conversation evaluation remain preview."
    },
    "foundry_a2a": {
      "support": "preview",
      "owner": "curriculum-opt-in",
      "note": "New integrations target A2A v1.0; project connections, RBAC, and agent cards are provisioned externally."
    },
    "foundry_context_engineering": {
      "support": "native-provider",
      "owner": "application",
      "note": "Agent Framework context providers and Responses compaction are current; managed Memory is preview."
    },
    "otel_dual_export": {
      "support": "preview",
      "owner": "application-with-platform-telemetry",
      "note": "One OpenTelemetry provider can fan spans to Application Insights and an MLflow OTLP endpoint; there is no backend-to-backend synchronization."
    },
    "automatic_evaluations": {
      "support": "preview",
      "owner": "platform-governed"
    },
    "agent_serving": {
      "support": "preview",
      "owner": "databricks-native-with-aai-resource-contract"
    },
    "langgraph": {
      "support": "native-framework",
      "owner": "application",
      "note": "Supported through MLflow LangChain autologging; graph and state APIs are not wrapped by aai-core."
    },
    "decision_records": {
      "support": "preview",
      "owner": "aai-core"
    },
    "deterministic_scorers": {
      "support": "preview",
      "owner": "aai-core"
    },
    "production_feedback_curation": {
      "support": "preview",
      "owner": "mlflow-native-with-aai-governance",
      "note": "Scorer sampling registration runs from a Databricks notebook; aai-core supplies judge resolution, feedback, and trace curation."
    },
    "prompt_promotion_gating": {
      "support": "preview",
      "owner": "mlflow-native-with-aai-governance"
    },
    "self_service_analytics": {
      "support": "preview",
      "owner": "template-owned",
      "note": "Semantic contract, warehouse executor protocol, and provenance discipline are generated application code in analytics-app; aai-core wraps none of it."
    },
    "agent_evaluation_toolkit": {
      "support": "preview",
      "owner": "aai-core",
      "note": "agentkit CLI: comparison-first evaluation, shared scorer registry, promotion gate"
    }
  }
}
