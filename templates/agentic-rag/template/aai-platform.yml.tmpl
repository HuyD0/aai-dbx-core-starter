platform:
  application: {{.application_name}}
  project: {{.project_name}}
  environment: dev
  team: {{.team}}
  owner_group: {{.owner_group}}
  cost_center: {{.cost_center}}
  data_classification: internal
  lifecycle: experimental
  repository: replace-with-owner/{{.project_name}}
  release: dev
  tag_schema_version: "1"
  catalog: {{.catalog}}
  schema: {{.schema}}
  experiment_name: /Shared/{{.project_name}}
  azure_identity: azure_cli

providers:
  models:
    general-chat:
      provider: {{.model_provider}}
      endpoint: {{.foundry_endpoint}}
      deployment: {{.model_deployment}}
      capabilities:
        streaming: true
        tool_calling: true
        structured_output: true
  embeddings:
    knowledge-embedding:
      provider: {{.model_provider}}
      endpoint: {{.foundry_endpoint}}
      deployment: {{.embedding_deployment}}
      dimensions: 1536
  retrievers:
    product-knowledge:
      provider: {{.retrieval_provider}}
      endpoint: {{.search_endpoint}}
      index: {{.search_index}}
      id_field: id
      content_field: content
      source_uri_field: source_uri
      chunk_id_field: chunk_id
      vector_fields: [content_vector]
      columns: [id, content, source_uri, chunk_id]

# Secret references may be added here. Never add secret values.
secrets: {}
