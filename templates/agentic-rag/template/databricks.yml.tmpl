bundle:
  name: {{.project_name}}

variables:
  cost_center:
    default: {{.cost_center}}
  team:
    default: {{.team}}
  owner_group:
    default: {{.owner_group}}
  aai_core_version:
    default: {{.aai_core_version}}
  aai_core_volume:
    default: {{.aai_core_volume}}
  compute_policy_id:
    default: {{.compute_policy_id}}

include:
  - resources/*.yml

artifacts:
  application:
    type: whl
    build: python scripts/build_application.py

targets:
  dev:
    mode: development
    default: true
    workspace:
      host: {{.workspace_host}}
    presets:
      tags:
        application: {{.application_name}}
        project: {{.project_name}}
        environment: ${bundle.target}
        team: ${var.team}
        owner_group: ${var.owner_group}
        cost_center: ${var.cost_center}
        data_classification: internal
        lifecycle: experimental
        tag_schema_version: "1"
