{
  "welcome_message": "Create an AAI Agentic RAG project",
  "properties": {
    "project_name": {
      "type": "string",
      "default": "aai-agentic-rag",
      "description": "Project and bundle name",
      "order": 1,
      "pattern": "^[a-z][a-z0-9-]+$",
      "pattern_match_failure_message": "Use lowercase letters, numbers, and hyphens."
    },
    "application_name": {
      "type": "string",
      "default": "knowledge-assistant",
      "description": "Application identifier used in tags and traces",
      "order": 2
    },
    "team": {
      "type": "string",
      "default": "data-platform",
      "description": "Owning team",
      "order": 3
    },
    "owner_group": {
      "type": "string",
      "default": "group:data-platform-owners",
      "description": "Non-personal owning group",
      "order": 4
    },
    "cost_center": {
      "type": "string",
      "default": "CC-1234",
      "description": "Non-secret finance cost center",
      "order": 5
    },
    "catalog": {
      "type": "string",
      "default": "main",
      "description": "Unity Catalog catalog",
      "order": 6
    },
    "schema": {
      "type": "string",
      "default": "agentic_apps",
      "description": "Unity Catalog schema",
      "order": 7
    },
    "model_provider": {
      "type": "string",
      "default": "databricks",
      "description": "Model provider",
      "enum": ["databricks", "foundry"],
      "order": 8
    },
    "model_deployment": {
      "type": "string",
      "default": "replace-with-model-endpoint",
      "description": "Databricks endpoint or Foundry deployment name",
      "order": 9
    },
    "foundry_endpoint": {
      "type": "string",
      "default": "https://replace-with-foundry-resource.services.ai.azure.com",
      "description": "Foundry resource endpoint; ignored for Databricks models",
      "order": 10
    },
    "retrieval_provider": {
      "type": "string",
      "default": "azure_ai_search",
      "description": "Retrieval provider",
      "enum": ["azure_ai_search", "databricks_ai_search"],
      "order": 11
    },
    "search_endpoint": {
      "type": "string",
      "default": "https://replace-with-search-service.search.windows.net",
      "description": "Azure AI Search service or Databricks AI Search endpoint",
      "order": 12
    },
    "search_index": {
      "type": "string",
      "default": "replace-with-search-index",
      "description": "Search index name",
      "order": 13
    },
    "embedding_deployment": {
      "type": "string",
      "default": "replace-with-embedding-endpoint",
      "description": "Embedding deployment or endpoint name",
      "order": 14
    },
    "aai_core_version": {
      "type": "string",
      "default": "0.1.0",
      "description": "Pinned aai-core SDK version",
      "order": 15
    },
    "aai_core_volume": {
      "type": "string",
      "default": "/Volumes/platform/artifacts/python_packages",
      "description": "Unity Catalog volume holding aai-core wheels",
      "order": 16
    },
    "workspace_host": {
      "type": "string",
      "default": "https://adb-7405609799238491.11.azuredatabricks.net",
      "description": "Development Azure Databricks workspace",
      "order": 17
    },
    "compute_policy_id": {
      "type": "string",
      "default": "0005F2031B6D2319",
      "description": "Constrained Job Compute policy",
      "order": 18
    }
  },
  "success_message": "Project created. Read README.md, install the pinned SDK, and run the credential-free tests."
}
