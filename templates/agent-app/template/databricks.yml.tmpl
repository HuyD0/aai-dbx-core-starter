bundle:
  name: {{.project_name}}

variables:
  aai_core_version:
    default: {{.aai_core_version}}
  aai_core_volume:
    default: {{.aai_core_volume}}
  deployment_environment:
    description: Platform-owned runtime environment selected by the bundle target.
  deployment_lifecycle:
    description: Platform-owned lifecycle selected by the bundle target.
  deployment_release:
    description: >-
      Immutable source commit promoted by CI. The dev target has a local fallback;
      UAT deliberately requires BUNDLE_VAR_deployment_release.
  prompt_version:
    description: Exact immutable Prompt Registry version evaluated and served.
    default: "{{.prompt_version}}"
  source_commit:
    description: CI-attested source commit; local-dev fails release evidence joins.
    default: local-dev
  source_state:
    description: CI-attested Git worktree state; release gates fail closed unless clean.
    default: unknown
  # Compute shape as variables so environments/policies can override them
  # without editing resource files (the compute policy remains the enforcer).
  node_type_id:
    description: Azure VM type for job clusters.
    default: Standard_DS3_v2
  spark_version:
    description: Databricks Runtime for job clusters.
    default: 18.0.x-scala2.13

include:
  - resources/*.yml

artifacts:
  application:
    type: whl
    build: python scripts/build_application.py

targets:
  dev:
    mode: development
    default: true
    workspace:
      host: {{.workspace_host}}
    variables:
      deployment_environment: dev
      deployment_lifecycle: experimental
      deployment_release: local-dev
    presets:
      tags:
        application: {{.application_name}}
        project: {{.project_name}}
        environment: ${bundle.target}
        team: {{.team}}
        owner_group: {{.owner_group}}
        cost_center: {{.cost_center}}
        data_classification: internal
        lifecycle: ${var.deployment_lifecycle}
        tag_schema_version: "2"

  uat:
    mode: production
    workspace:
      # Literal by design: the CLI forbids variable interpolation in auth fields.
      host: {{.uat_workspace_host}}
    # The externally provisioned UAT CI identity deploys and runs the bundle.
    # Keep run_as unset; do not fall back to the shared legacy principal.
    variables:
      deployment_environment: uat
      deployment_lifecycle: validation
    presets:
      tags:
        application: {{.application_name}}
        project: {{.project_name}}
        environment: ${bundle.target}
        team: {{.team}}
        owner_group: {{.owner_group}}
        cost_center: {{.cost_center}}
        data_classification: internal
        lifecycle: ${var.deployment_lifecycle}
        tag_schema_version: "2"
