platform:
  application: {{.application_name}}
  project: {{.project_name}}
  environment: dev
  team: {{.team}}
  owner_group: {{.owner_group}}
  cost_center: {{.cost_center}}
  data_classification: internal
  lifecycle: experimental
  repository: {{.repository_url}}
  release: dev
  tag_schema_version: "2"
  catalog: {{.catalog}}
  schema: {{.schema}}
  experiment_name: /Shared/{{.application_name}}-quality-cost-release
  azure_identity: azure_cli

providers:
  models:
    # In the enterprise this endpoint is gateway-fronted (Databricks AI
    # Gateway on the serving endpoint, or switch the provider to azure_apim
    # with base_url/token_scope) — application code never changes.
    general-chat:
      provider: {{.model_provider}}
      endpoint: {{.foundry_endpoint}}
      deployment: {{.model_deployment}}
      capabilities:
        tool_calling: true
        structured_output: true
    # Evaluation judges always use an approved gateway-fronted Databricks
    # endpoint, including an external-model endpoint for Foundry judges.
    judge-model:
      provider: databricks
      deployment: {{.judge_deployment}}

# Secret references may be added here. Never add secret values.
secrets: {}
