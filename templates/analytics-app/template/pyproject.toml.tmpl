[build-system]
requires = ["hatchling>=1.31,<2"]
build-backend = "hatchling.build"

[project]
name = "{{.project_name}}"
version = "0.1.0"
requires-python = ">=3.11,<3.13"
dependencies = [
  "azure-identity>=1.25.3,<2",
  "databricks-openai>=0.17,<0.18",
  "databricks-sdk>=0.122,<0.123",
  "mlflow[databricks]>=3.15.1,<3.16",
  "openai>=2.48,<3",
  "pydantic>=2.12,<3",
  "PyYAML>=6.0.3,<7",
]

[project.optional-dependencies]
dev = [
  "black>=26.5.1,<27",
  "build>=1.5,<2",
  "mypy>=1.18,<2",
  "pip-audit>=2.9,<3",
  "pytest>=9.1.1,<10",
  "pytest-cov>=7,<8",
  "ruff>=0.16,<1",
  "types-PyYAML>=6.0.12,<7",
]

[tool.hatch.build.targets.wheel]
packages = ["src/app"]

[tool.pytest.ini_options]
pythonpath = ["src"]
testpaths = ["tests"]

[tool.mypy]
# Provider packages and their NumPy stubs expose version-sensitive internals.
# Application boundaries are checked against aai-core-owned protocols instead.
follow_imports_for_stubs = true

[[tool.mypy.overrides]]
module = [
  "mlflow",
  "numpy",
  "numpy.*",
  "openai",
]
follow_imports = "skip"

[tool.ruff]
target-version = "py311"
line-length = 88

[tool.ruff.lint]
select = ["E", "F", "I", "UP", "B", "C90", "SIM"]

[tool.ruff.lint.mccabe]
max-complexity = 12

[tool.ruff.lint.isort]
known-first-party = ["aai_core", "app"]
