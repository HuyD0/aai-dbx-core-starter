resources:
  jobs:
    release_gate:
      name: "[${bundle.target}] {{.application_name}}"
      tasks:
        - task_key: evaluate
          spark_python_task:
            python_file: ../evals/evaluate.py
            # Bundle jobs are non-interactive. Local callers omit this and
            # see the estimated judge spend before confirming.
            parameters:
              - "--yes"
          job_cluster_key: default
          libraries:
            - whl: ../dist/*.whl
            - whl: ${var.aai_core_volume}/aai_core/${var.aai_core_version}/aai_core-${var.aai_core_version}-py3-none-any.whl
            # Certified transitive runtime lock — the same file local installs
            # use (bundle-synced to the workspace).
            - requirements: ../requirements.lock

      job_clusters:
        - job_cluster_key: default
          new_cluster:
            spark_version: ${var.spark_version}
            node_type_id: ${var.node_type_id}
            num_workers: 1
            policy_id: {{.compute_policy_id}}
            custom_tags:
              application: {{.application_name}}
              project: {{.project_name}}
              environment: ${bundle.target}
              team: {{.team}}
              owner_group: {{.owner_group}}
              cost_center: {{.cost_center}}
              data_classification: internal
              lifecycle: experimental
              tag_schema_version: "2"

      # Uncomment to run the suite on a schedule (continuous evaluation):
      # schedule:
      #   quartz_cron_expression: "0 0 6 * * ?"
      #   timezone_id: UTC
