platform:
  application: {{.application_name}}
  project: {{.project_name}}
  environment: dev
  team: {{.team}}
  owner_group: {{.owner_group}}
  cost_center: {{.cost_center}}
  data_classification: internal
  lifecycle: experimental
  repository: {{.repository_url}}
  # Bundle jobs override this with the CI-attested source commit.
  release: local-dev
  tag_schema_version: "2"
  catalog: {{.catalog}}
  schema: {{.schema}}
  experiment_name: /Shared/{{.application_name}}-quality-cost-evaluation
  azure_identity: azure_cli

providers:
  models:
    # The LLM judges run through this gateway-fronted Databricks serving
    # endpoint (for external models, an external-model endpoint). Judge cost
    # is real cost — budget evaluation like any other workload.
    judge-model:
      provider: databricks
      deployment: {{.model_deployment}}
    # The application under evaluation, used by `evals/evaluate.py --mode
    # endpoint`. Leave commented while scoring recorded answer sheets.
    # target-model:
    #   provider: databricks
    #   deployment: replace-with-target-endpoint

# Secret references may be added here. Never add secret values.
secrets: {}
