platform:
  application: {{.application_name}}
  project: {{.project_name}}
  environment: dev
  team: {{.team}}
  owner_group: {{.owner_group}}
  cost_center: {{.cost_center}}
  data_classification: internal
  lifecycle: experimental
  repository: replace-with-owner/{{.project_name}}
  release: dev
  tag_schema_version: "1"
  catalog: {{.catalog}}
  schema: {{.schema}}
  experiment_name: /Shared/{{.project_name}}
  azure_identity: azure_cli

providers:
  models:
    # The LLM judges run through this endpoint (gateway-fronted in the
    # enterprise). Judge cost is real cost — budget evaluation like any
    # other workload.
    judge-model:
      provider: {{.model_provider}}
      endpoint: {{.foundry_endpoint}}
      deployment: {{.model_deployment}}
    # The application under evaluation, used by `evals/evaluate.py --mode
    # endpoint`. Leave commented while scoring recorded answer sheets.
    # target-model:
    #   provider: databricks
    #   deployment: replace-with-target-endpoint

# Secret references may be added here. Never add secret values.
secrets: {}
