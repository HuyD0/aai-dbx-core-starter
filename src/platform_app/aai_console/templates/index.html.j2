{% extends "base.html.j2" %}
{% block title %}{{ active.title }} — AAI platform console{% endblock %}

{% block main %}
<header class="topbar">
  <div class="topbar__title">
    <h1>{{ active.title }}</h1>
    <span class="topbar__sub">{{ active.subtitle }} · <span data-track-progress>0 of {{ active.steps | length }} complete</span></span>
  </div>
  <div class="topbar__actions">
    <button class="iconbtn" type="button" id="checks-run" title="Check platform state">
      {% include "fragments/icon_pulse.svg.j2" %}
    </button>
  </div>
</header>

<div class="scroll" id="scroll">
  <article class="prose">
    {% if active.summary %}
      <p class="lede">{{ active.summary | icode }}</p>
    {% endif %}

    {% for step in active.steps %}
      <section class="step" id="step-{{ step.id }}" data-step="{{ active.id }}/{{ step.id }}">
        <h2 class="step__title">
          <span class="step__index">{{ loop.index }}</span>{{ step.title }}
          <button class="step__complete" type="button" data-step-complete aria-pressed="false">Mark complete</button>
        </h2>

        {% if step.body %}<p>{{ step.body | icode }}</p>{% endif %}

        {% if step.checklist %}
          <ul class="checklist">
            {% for item in step.checklist %}<li>{{ item | icode }}</li>{% endfor %}
          </ul>
        {% endif %}

        {% if step.choices %}
          <div class="choices" data-choices>
            {% for choice in step.choices %}
              <button class="choice" type="button" data-template="{{ choice.id }}">
                <span class="choice__label">{{ choice.label }}</span>
                <span class="choice__detail">{{ choice.detail }}</span>
              </button>
            {% endfor %}
          </div>
        {% endif %}

        {% if step.blocks %}
          {% with blocks = step.blocks %}
            {% include "fragments/blocks.html.j2" %}
          {% endwith %}
        {% endif %}

        {% if step.generate %}
          <div class="generate-form">
            <label for="project-name">Project name</label>
            <input id="project-name" name="project_name" value="my-project" pattern="[A-Za-z0-9][A-Za-z0-9._-]{0,63}" aria-describedby="project-name-help" />
            <small id="project-name-help">Start with a letter or number; then use letters, numbers, dots, underscores, or hyphens.</small>
          </div>
          <div class="generate" id="generate-target" aria-live="polite">
            <p class="muted">Pick a template above to build your exact command.</p>
          </div>
        {% endif %}

        {% if step.verify %}
          <div class="verify">
            <button class="ghostbtn" type="button" data-run-checks>Check platform state</button>
          </div>
        {% endif %}

        {% if step.source %}
          <p class="source">Source: <code>{{ step.source }}</code></p>
        {% endif %}
      </section>
    {% endfor %}

    <div id="checks-target" class="checks-target"></div>
  </article>
</div>

<div class="guide-search">
  <label class="guide-search__label" for="guide-search-input">Search setup, access, templates, evaluation, and cost</label>
  <div class="guide-search__box">
    {% include "fragments/icon_search.svg.j2" %}
    <input id="guide-search-input" type="search" placeholder="Search the guide…  (press / )" autocomplete="off" />
    <button type="button" id="guide-search-submit">Search</button>
  </div>
  <p class="composer__note">{{ platform_state_heading }}</p>
</div>
{% endblock %}
